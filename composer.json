{
    "name": "joust/joust",
    "description": "Just another JSON API kit",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Woody Gilk",
            "email": "woody.gilk@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "errata/errata": "^0.2.0",
        "league/uri": "7.x-dev as 7.9.0",
        "league/uri-interfaces": "7.x-dev as 7.9.0",
        "php-standard-library/json": "^6.0",
        "php-standard-library/str": "^6.0",
        "php-standard-library/vec": "^6.0",
        "psr/container": "^1.0 || ^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-server-handler": "^1.0",
        "wyrihaximus/list-classes-in-directory": "^1.7"
    },
    "require-dev": {
        "captainhook/captainhook": "^5.29",
        "captainhook/hook-installer": "^1.0",
        "carthage-software/mago": "^1.50",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^13.3",
        "rregeer/phpunit-coverage-check": "^0.3.1"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Joust\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joust\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "captainhook/hook-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyze": "mago analyze",
        "check": "mago format --check",
        "coverage": "coverage-check build/phpunit/clover.xml 100",
        "fix": [
            "mago lint --fix",
            "mago analyze --fix",
            "mago format"
        ],
        "format": "mago format",
        "lint": "mago lint",
        "phpunit": "phpunit -d memory_limit=4G",
        "test": [
            "@phpunit",
            "@coverage"
        ],
        "verify": [
            "@check",
            "@lint",
            "@analyze",
            "@test"
        ]
    }
}
